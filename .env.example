# Mind Map Server Configuration Template
# Copy this file to .env and customize the values for your setup

# Port for the server to listen on (default: 3000)
PORT=3333

# Working root directory for XML files
# Use absolute path or relative to the project root
# Examples:
# WORKING_ROOT_DIR=/Users/username/projects/mindmaps  # Absolute path
# WORKING_ROOT_DIR=./data                             # Relative path to ./data folder
# WORKING_ROOT_DIR=../mindmap-files                   # Relative path to parent folder
WORKING_ROOT_DIR=/Users/genereux/Dev/gestion

# Optional: Server host binding (default: all interfaces)
# Use localhost to restrict to local access only
# HOST=localhost

# Optional: Enable debug logging (default: false)
# Set to 'true' to enable detailed server logging
DEBUG=true

# ── Turso Cloud Database (optional but recommended) ──────────────────────────
# Get these by running:
#   turso auth login
#   turso db create map
#   turso db show map --url          → TURSO_DATABASE_URL
#   turso db tokens create map       → TURSO_AUTH_TOKEN
#
# When set: the server pulls the latest data from Turso on startup and
# replicates every write to Turso in the background. The local mind_maps.db
# continues to serve all reads (fast, works offline on a train).
# When not set: local-only mode (current behaviour, unchanged).
#
TURSO_DATABASE_URL=libsql://map-<your-org>.turso.io
TURSO_AUTH_TOKEN=<your-auth-token>

# ── Remote sync webhook (optional) ───────────────────────────────────────────
# When set, every local write that replicates to Turso also notifies the remote
# server to pull fresh data immediately — no redeploy needed.
#
# REMOTE_SYNC_URL = full URL of the remote /api/turso/sync endpoint
# SYNC_SECRET     = shared secret checked by the remote server (set the same
#                   value in Railway Variables)
#
REMOTE_SYNC_URL=https://soothing-tenderness-production-60f6.up.railway.app/api/turso/sync
SYNC_SECRET=<choose-a-random-secret>